  "avg_logprob": -0.3928,
  "compressao": 0.9875
 },
 {
  "ini": 77.3,
  "fim": 91.38,
  "texto": "Isso é muita responsabilidade para uma pessoa só. Você já conversou com a sua chefia sobre a carga de trabalho?",
