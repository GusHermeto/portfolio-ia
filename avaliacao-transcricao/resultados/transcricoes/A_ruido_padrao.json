  "avg_logprob": -0.1804,
  "compressao": 1.126
 },
 {
  "ini": 54.02,
  "fim": 59.14,
  "texto": "Parece que a revisão traz um alívio rápido, mas depois o medo volta. É isso?",
  "no_speech_prob": 0.0,
  "avg_logprob": -0.1804,
  "compressao": 1.126
 },
 {
